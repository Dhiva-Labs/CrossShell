[Desktop Entry]
Type=Application
Name=CrossShell
GenericName=Linux and Windows, one desk
Comment=SSH both ways, files, port forwards and remote desktop between your Linux and Windows machines
Exec=crossshell
Icon=${SNAP}/usr/share/icons/hicolor/256x256/apps/crossshell.png
Terminal=false
Categories=Network;RemoteAccess;Utility;
Keywords=ssh;sftp;remote;desktop;windows;linux;vnc;rdp;teamviewer;
StartupWMClass=com.dhivalabs.cross_shell
